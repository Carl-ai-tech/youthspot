{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "YouthScope private static site and rate-limited Bedrock API; exact regional model or US Sonnet 4.6 inference profile.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String",
      "Description": "Existing private Lambda artifact bucket in this stack region; not the site bucket.",
      "MinLength": 3
    },
    "ArtifactKey": {
      "Type": "String",
      "Description": "Immutable SHA-addressed Lambda ZIP object key.",
      "MinLength": 1
    },
    "BedrockModelId": {
      "Type": "String",
      "Description": "Exact regional model ID, or us.anthropic.claude-sonnet-4-6 with BedrockModelMode=us-sonnet-4-6.",
      "AllowedPattern": "[a-z0-9][a-z0-9.:-]*",
      "MinLength": 3
    },
    "FunctionName": {
      "Type": "String",
      "Default": "youthscope-api",
      "AllowedPattern": "[A-Za-z0-9_-]+",
      "MaxLength": 64,
      "Description": "Unique Lambda name in this account and region."
    },
    "BedrockModelMode": {
      "Type": "String",
      "Default": "regional",
      "AllowedValues": [
        "regional",
        "us-sonnet-4-6"
      ],
      "Description": "regional grants only the source-region model. us-sonnet-4-6 grants the exact US profile and Sonnet 4.6 in us-east-1, us-east-2, us-west-2."
    },
    "ReleaseCommit": {
      "Type": "String",
      "Default": "unknown",
      "AllowedPattern": "unknown|[0-9a-f]{7,40}",
      "Description": "Non-secret Git commit identifier reported by API health; use the exact deployed source commit."
    }
  },
  "Rules": {
    "AllowedDeploymentRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Contains": [
              [
                "us-east-1",
                "us-west-2"
              ],
              {
                "Ref": "AWS::Region"
              }
            ]
          },
          "AssertDescription": "Deploy only in us-east-1 or us-west-2."
        }
      ]
    },
    "SonnetProfileMatchesMode": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "BedrockModelMode"
                      },
                      "us-sonnet-4-6"
                    ]
                  }
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "BedrockModelId"
                  },
                  "us.anthropic.claude-sonnet-4-6"
                ]
              }
            ]
          },
          "AssertDescription": "us-sonnet-4-6 mode requires model ID us.anthropic.claude-sonnet-4-6."
        }
      ]
    }
  },
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "RateTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${FunctionName}"
        },
        "RetentionInDays": 7
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "YouthScopeRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApiLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${SiteBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "RateTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Fn::If": [
                    "UseSonnetUSProfile",
                    {
                      "Sid": "InvokeExactSonnetUSProfile",
                      "Effect": "Allow",
                      "Action": [
                        "bedrock:InvokeModel"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/us.anthropic.claude-sonnet-4-6"
                      }
                    },
                    {
                      "Effect": "Allow",
                      "Action": [
                        "bedrock:InvokeModel"
                      ],
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/${BedrockModelId}"
                      }
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "UseSonnetUSProfile",
                    {
                      "Sid": "InvokeSonnetOnlyThroughUSProfile",
                      "Effect": "Allow",
                      "Action": [
                        "bedrock:InvokeModel"
                      ],
                      "Resource": [
                        {
                          "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-4-6"
                        },
                        {
                          "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-east-2::foundation-model/anthropic.claude-sonnet-4-6"
                        },
                        {
                          "Fn::Sub": "arn:${AWS::Partition}:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-6"
                        }
                      ],
                      "Condition": {
                        "StringEquals": {
                          "bedrock:InferenceProfileArn": {
                            "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}:${AWS::AccountId}:inference-profile/us.anthropic.claude-sonnet-4-6"
                          }
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "deploy.runtime.handler",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Timeout": 60,
        "MemorySize": 512,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Environment": {
          "Variables": {
            "YOUTHSCOPE_RATE_TABLE": {
              "Ref": "RateTable"
            },
            "YOUTHLENS_LLM_BACKEND": "bedrock",
            "YOUTHLENS_AWS_REGION": {
              "Ref": "AWS::Region"
            },
            "YOUTHLENS_BEDROCK_MODEL": {
              "Ref": "BedrockModelId"
            },
            "YOUTHLENS_BUCKET": {
              "Ref": "SiteBucket"
            },
            "RELEASE_COMMIT": {
              "Ref": "ReleaseCommit"
            }
          }
        }
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED"
      }
    },
    "ApiUrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "ApiInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "SiteOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3-oac"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "ApiNoCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-api-no-cache"
          },
          "DefaultTTL": 0,
          "MaxTTL": 0,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            },
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false
          }
        }
      }
    },
    "ApiForwarding": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-api-forward"
          },
          "CookiesConfig": {
            "CookieBehavior": "none"
          },
          "HeadersConfig": {
            "HeaderBehavior": "allExcept",
            "Headers": [
              "host"
            ]
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "all"
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "DependsOn": [
        "ApiUrlPermission",
        "ApiInvokePermission"
      ],
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "DefaultRootObject": "preview.html",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "SiteOAC"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            },
            {
              "Id": "api",
              "DomainName": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Fn::GetAtt": [
                          "ApiUrl",
                          "FunctionUrl"
                        ]
                      }
                    ]
                  }
                ]
              },
              "CustomOriginConfig": {
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ],
                "OriginReadTimeout": 60
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "MinTTL": 0,
            "DefaultTTL": 300,
            "MaxTTL": 3600,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            }
          },
          "CacheBehaviors": [
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "ApiNoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ApiForwarding"
              },
              "Compress": false,
              "PathPattern": "/api"
            },
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "CachePolicyId": {
                "Ref": "ApiNoCache"
              },
              "OriginRequestPolicyId": {
                "Ref": "ApiForwarding"
              },
              "Compress": false,
              "PathPattern": "/api/*"
            }
          ]
        }
      }
    },
    "SitePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SiteBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${SiteBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "SiteBucket": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "SiteUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}/"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}/api"
      }
    },
    "DirectFunctionUrl": {
      "Value": {
        "Fn::GetAtt": [
          "ApiUrl",
          "FunctionUrl"
        ]
      },
      "Description": "Public origin URL: direct calls are possible; not an authentication boundary."
    },
    "FunctionName": {
      "Value": {
        "Ref": "ApiFunction"
      }
    },
    "RateTable": {
      "Value": {
        "Ref": "RateTable"
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "ApiLogs"
      }
    }
  },
  "Conditions": {
    "UseSonnetUSProfile": {
      "Fn::Equals": [
        {
          "Ref": "BedrockModelMode"
        },
        "us-sonnet-4-6"
      ]
    }
  }
}
